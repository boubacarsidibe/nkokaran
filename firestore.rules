rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isSignedIn();
      // Owner-only writes, with sane bounds on the public leaderboard fields.
      // (XP is still client-reported; true anti-cheat needs Cloud Functions.)
      allow create, update: if isOwner(uid)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp < 1000000
        && request.resource.data.weeklyXp is int
        && request.resource.data.weeklyXp >= 0
        && request.resource.data.weeklyXp <= 7000;
      allow delete: if isOwner(uid);

      match /friends/{friendUid} {
        allow read, write: if isOwner(uid);
      }

      match /progress/{docId} {
        allow read, write: if isSignedIn() && isOwner(uid);
      }
    }

    match /lessonThreads/{unitId}/posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 30
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update, delete: if false;
    }

    // Signalements de messages : écriture seule, lecture réservée à la console.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 100;
      allow read, update, delete: if false;
    }

    // A player may only touch their own entry in the club's members map and
    // never the club's name or goal.
    match /clubs/{clubId} {
      allow read: if isSignedIn();

      // Only lets the caller create a fresh club with default values.
      allow create: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.weeklyGoalXp is number
        && request.resource.data.members is map;

      // Joining/contributing only ever touches the caller's own entry in
      // `members`; nobody can rename a club, change its goal, or edit
      // another member's XP.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]);

      allow delete: if false;
    }
  }
}
